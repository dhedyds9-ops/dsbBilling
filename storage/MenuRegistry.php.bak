    private static function applyBadges(array $navigation): array
    {
        $unpaidInvoices = Invoice::where('status', 'unpaid')->count();
        $activeAlarms = class_exists(ACSAlarm::class) ? ACSAlarm::where('status', 'active')->count() : 0;

        foreach ($navigation as &$category) {
            foreach (($category['groups'] ?? []) as &$group) {
                foreach (($group['items'] ?? []) as &$item) {
                    if (($item['route'] ?? '') === 'billing.invoices.index' && $unpaidInvoices > 0) {
                        $item['badge'] = $unpaidInvoices;
                    }
                    if (($item['route'] ?? '') === 'acs.alarms.index' && $activeAlarms > 0) {
                        $item['badge'] = $activeAlarms;
                    }
                }
            }
        }
        return $navigation;
    }

    private static function buildResellerNavigation(): array
    {
        return [
            [
                'label' => 'Dashboard Reseller',
                'icon' => 'home',
                'route' => 'reseller-portal.dashboard',
                'active' => 'reseller-portal.dashboard',
            ],
        ];
    }

    private static function buildCustomerNavigation(): array
    {
        $userId = Auth::id();
        $customer = \App\Models\CRM\Customer::with(['customerServices.pppoeUser', 'customerServices.hotspotUser'])
            ->where('user_id', $userId)
            ->first();
            
        $isPppoe = false;
        $isHotspot = false;
        
        if ($customer) {
            foreach ($customer->customerServices as $cs) {
                if ($cs->pppoeUser) $isPppoe = true;
                if ($cs->hotspotUser) $isHotspot = true;
            }
        }

        $selfServiceItems = [];
        
        if ($isPppoe) {
            $selfServiceItems[] = [
                'label' => 'Pengaturan Modem',
                'route' => 'customer-portal.self-service.change-onu-wifi-password',
                'icon' => 'router',
                'active' => 'customer-portal.self-service.change-onu-wifi-password',
            ];
            $selfServiceItems[] = [
                'label' => 'Perangkat Terhubung',
                'route' => 'customer-portal.self-service.connected-devices',
                'icon' => 'devices',
                'active' => 'customer-portal.self-service.connected-devices',
            ];
        }
        
        if ($isHotspot) {
            $selfServiceItems[] = [
                'label' => 'Username & Password',
                'route' => 'customer-portal.self-service.change-hotspot-credentials',
                'icon' => 'manage_accounts',
                'active' => 'customer-portal.self-service.change-hotspot-credentials',
            ];
            $selfServiceItems[] = [
                'label' => 'User Aktif',
                'route' => 'customer-portal.self-service.active-sessions',
                'icon' => 'history',
                'active' => 'customer-portal.self-service.active-sessions',
            ];
        }

        $navigation = [
            [
                'label' => 'Dashboard',
                'icon' => 'home',
                'route' => 'customer-portal.dashboard',
                'active' => 'customer-portal.dashboard',
                'groups' => null,
            ],
            [
                'label' => 'Layanan & Tagihan',
                'icon' => 'receipt_long',
                'groups' => [
                    [
                        'items' => [
                            [
                                'label' => 'Tagihan Saya',
                                'route' => 'customer-portal.billing.invoice-list',
                                'icon' => 'receipt',
                                'active' => 'customer-portal.billing.*',
                            ],
                            [
                                'label' => 'Ganti Paket Layanan',
                                'route' => 'customer-portal.self-service.change-plan',
                                'icon' => 'upgrade',
                                'active' => 'customer-portal.self-service.change-plan',
                            ],
                        ]
                    ]
                ]
            ]
        ];

        if (!empty($selfServiceItems)) {
            $navigation[] = [
                'label' => 'Self Service',
                'icon' => 'build',
                'groups' => [
                    [
                        'items' => $selfServiceItems
                    ]
                ]
            ];
        }

        $navigation[] = [
            'label' => 'Pengaturan',
            'icon' => 'settings',
            'groups' => [
                [
                    'items' => [
                        [
                            'label' => 'Profil Saya',
                            'route' => 'profile.edit',
                            'icon' => 'person',
                            'active' => 'profile.edit',
                        ],
                    ]
                ]
            ]
        ];

        return $navigation;
    }
