namespace App\Navigation;

use App\Models\ACS\ACSAlarm;
use App\Models\Billing\Invoice;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Auth;

class MenuRegistry
{
    public static function getNavigation(): array
    {
        $user = Auth::user();
        $role = $user ? ($user->roles->first()->name ?? 'guest') : 'guest';
        $userId = $user ? $user->id : 0;
        $jobFunction = $user ? ($user->job_function ?? 'none') : 'none';
        
        $cacheKey = "dsbilling_navigation.{$role}.{$jobFunction}.{$userId}.v5";

        $navigation = Cache::remember($cacheKey, 3600, function () use ($role, $user) {
            if ($role === 'reseller') {
                return self::buildResellerNavigation();
            }
            if ($role === 'customer') {
                return self::buildCustomerNavigation();
            }
            if ($role === 'manager' && $user && $user->job_function === \App\Enums\JobFunction::TECHNICIAN->value) {
                return self::buildTechnicianNavigation();
            }
            return self::buildNavigation();
        });

        return self::applyBadges($navigation);
    }

