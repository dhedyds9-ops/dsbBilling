# ====================== KONFIGURASI DSBILLING BAILEYS BOT ======================
# Copy file ini -> .env, lalu edit sesuai environment.

# --- Backend dsBilling Laravel ---
DSBILLING_BASE_URL=https://billing.isp-anda.co.id
# URL sigToken = md5(APP_KEY_LARAVEL:baileys) . Generate di tinker: substr(md5(config('app.key').':baileys'),0,24)
DSBILLING_WEBHOOK_SIGTOKEN=isi_dengan_24_karakter_md5_appkey_baileys

# --- Session / Auth Baileys ---
# Path untuk folder penyimpanan session (multi-device creds.json, sqlite3 store dll)
SESSION_NAME=dsbilling-primary
SESSION_FOLDER=./auth_sessions

# --- Rate Limit (anti banned WhatsApp) ---
# Jumlah maks pesan / 60 detik (default prod = 60, test = 10-20)
MAX_MSG_PER_MINUTE=60
# Delay ms antar pesan broadcast untuk menjaga pola manusiawi
BROADCAST_DELAY_MS=1200
# Cooldown detik antar chat ke nomor YANG SAMA (90 detik default)
SAME_NUMBER_COOLDOWN_S=90
# Maksimum chat per NOMOR per 24 jam (maks 20 = safe untuk no banned)
MAX_DAILY_PER_NUMBER=20

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=./logs/bot.log
